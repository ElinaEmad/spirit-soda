# Copy this file to ".env" and fill in your Supabase project values.
# WITHOUT these, the app still runs fully on a single device using local
# browser storage. WITH them, the cashier and display screens sync live
# across separate devices.
#
# Get these from: Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
